{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "20.19.4",
      "installCommand": "cd \"$(git rev-parse --show-toplevel)\" && npm ci --include=dev"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "20.19.4",
      "installCommand": "cd \"$(git rev-parse --show-toplevel)\" && npm ci --include=dev"
    },
    "production": {
      "channel": "production",
      "node": "20.19.4",
      "installCommand": "cd \"$(git rev-parse --show-toplevel)\" && npm ci --include=dev"
    }
  },
  "submit": {
    "production": {}
  }
}

# Copy to `.env` in this folder. Expo loads EXPO_PUBLIC_* at bundle time.
# Values: Supabase Project Settings → API → Project URL and anon public key.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional: Google Sign-In (native dev build)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

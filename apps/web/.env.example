# Canonical public URL for OAuth redirects (set on Vercel → Production + Preview if needed).
# Without this, sign-in uses the current browser origin; production should set this to avoid
# mismatches when Supabase “Site URL” / redirect allowlist must match exactly.
NEXT_PUBLIC_APP_URL=https://nonews.in

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

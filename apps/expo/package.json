{
  "name": "@nonews/expo",
  "version": "1.0.0",
  "private": false,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "prebuild:android": "expo prebuild --platform android --non-interactive --clean",
    "eas:build:android": "eas build --platform android --profile production",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:build:android:preview": "eas build --platform android --profile preview",
    "eas:build:ios:preview": "eas build --platform ios --profile preview",
    "ota:preview": "npx eas-cli update --branch preview",
    "ota:production": "npx eas-cli update --branch production",
    "type-check": "tsc --noEmit",
    "lint": "expo lint"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.0.6",
    "@nonews/shared": "*",
    "@nonews/ui": "^1.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native/js-polyfills": "0.81.5",
    "@tanstack/react-query": "^5.90.21",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^0.575.0",
    "metro-runtime": "^0.83.6",
    "nativewind": "^4.2.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react-native": "^0.72.8",
    "ajv": "^8.18.0",
    "typescript": "~5.9.2"
  }
}

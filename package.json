{
  "name": "nonews",
  "version": "1.0.0",
  "private": true,
  "description": "NoNews — Editorial summaries without the noise. nonews.in · Expo + Next.js monorepo",
  "workspaces": [
    "apps/expo",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "start:web": "npm run build --workspace=@nonews/web && cd apps/web && npm run start",
    "expo": "expo start ./apps/expo",
    "start:expo": "expo start ./apps/expo",
    "eas:build:android": "npm --workspace @nonews/expo run eas:build:android",
    "eas:build:ios": "npm --workspace @nonews/expo run eas:build:ios",
    "eas:build:android:preview": "npm --workspace @nonews/expo run eas:build:android:preview",
    "eas:build:ios:preview": "npm --workspace @nonews/expo run eas:build:ios:preview",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"apps/**/*.{js,jsx,ts,tsx,json,css,md}\" \"packages/**/*.{js,ts,json}\"",
    "db:push": "npx supabase db push",
    "scrape-authors": "ts-node scripts/scrape-indian-express-authors.ts",
    "postinstall": "npm install lightningcss-darwin-x64@1.31.1 --no-save --ignore-scripts 2>/dev/null || true"
  },
  "devDependencies": {
    "expo-router": "~6.0.23",
    "react-native-worklets": "0.5.1",
    "@expo/config-plugins": "~54.0.4",
    "expo": "~54.0.0",
    "metro-runtime": "0.83.6",
    "@react-native/js-polyfills": "0.81.5",
    "@supabase/supabase-js": "^2.47.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "linkedom": "^0.18.0",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.3.0",
    "typescript": "~5.9.2"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "optionalDependencies": {
    "lightningcss-darwin-x64": "^1.31.1"
  },
  "overrides": {
    "@types/react": "~19.1.10",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
